{
  "name": "car-desktop",
  "private": true,
  "version": "0.1.0-alpha.1",
  "description": "CAR Desktop - 桌面壳消费内核 seam（立项书：car-docs/30-桌面v1/桌面端立项书.md）",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "node --experimental-transform-types --test --test-reporter=tap \"test/*.spec.ts\"",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "secrets-scan": "node --experimental-transform-types scripts/secrets-scan.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.6.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@lqc123qwe/car-runtime": "1.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
