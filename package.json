{
  "name": "car-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "CAR Desktop - 桌面壳消费内核 seam（立项书：car-docs/30-桌面v1/桌面端立项书.md）",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "node --experimental-transform-types --test --test-reporter=tap --test-force-exit \"test/*.spec.ts\"",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "secrets-scan": "node --experimental-transform-types scripts/secrets-scan.ts",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.yicaifeng.car-desktop",
    "productName": "CAR Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CAR-Desktop-${version}-win-x64-setup.exe"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@lqc123qwe/car-runtime": "1.15.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
